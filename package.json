{
  "name": "@side-screen/source",
  "version": "0.0.0",
  "description": "Side Screen: a local dashboard for the portrait side monitor (power, today, dev status).",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "nx serve web",
    "build": "nx run-many -t build -p api web",
    "start": "node dist/apps/api/main.js",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "check": "nx run-many -t lint test typecheck build",
    "launchd:install": "bash tools/launchd/install.sh",
    "launchd:uninstall": "bash tools/launchd/uninstall.sh",
    "launchd:restart": "launchctl kickstart -k gui/$(id -u)/com.klymenko.side-screen",
    "launchd:logs": "tail -f ~/Library/Logs/side-screen/server.log ~/Library/Logs/side-screen/server.err.log"
  },
