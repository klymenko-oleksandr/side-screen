# Copy to .env (git-ignored) and fill in. Every value is optional: a missing one
# just leaves that source empty, with a note on the dashboard.

# Google Calendar → Settings → your calendar → Integrate calendar → "Secret address in iCal format"
GOOGLE_CALENDAR_ICS_URL=

# vercel.com/account/settings/tokens. Scope it to your team; add the team id if projects live there.
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# dashboard.render.com → Account settings → API keys
RENDER_API_KEY=

# supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# github.com/settings/personal-access-tokens → fine-grained token, Repository access:
# "Public repositories (read-only)" is enough for public repos; it lifts the 60 requests/hour limit.
GITHUB_TOKEN=
